		visible: {styling.is_foil == "yes"}

	serialized:
		left:	{103-2.5}
		top:	500
		width:	178
		height:	55
		z index: 5
		visible: { is_serialized() }
		render style: image
		image: { "Serialized.png" }

	serialized number 1:
		left: {if is_serialized() then (103+2.5) else 0 }
		top: {if is_serialized() then (500+5) else 0 }
		width: {if is_serialized() then (178-10) else 0 }
		height: {if is_serialized() then (55-10) else 0 }
		z index: 6
		alignment: middle center
		font:
			name: {"Magic Gotham Medium"}
			size: {23}
			color: white
			weight: {"bold"}
		visible: {is_serialized()}

	land dual overlay:
		left:	0
		top:	0
		width:	750
		height:	1050
		z index: 0
		render style: image
		image: { if is_land(card.type) and contains(card.card_color, match:",") then ( template_prefix()["land"] + land_second_code() + "lcard.png" ) else "" }
		mask: dual_mask.png

	foil layer:
		left:				0
		top:				0
		width:				750
		height:				1050
		z index:			1050
		visible:			{ styling.overlay != "none" and styling.overlay != "" }
		render style:		image
		image:				{ if styling.overlay == "" then "" else styling.overlay + "/overlay.png" }
